# Oracle Database server address, not the SQL Developer application
DB_USER=EVAL_APP
DB_PASSWORD=ChangeThisPassword!
# Example: localhost:1521/XEPDB1 for Oracle XE; confirm service name in your installation
DB_CONNECT_STRING=localhost:1521/XEPDB1
PORT=3000
# Set to a long random value before real use. Used to derive session tokens.
SESSION_SECRET=replace-with-a-long-random-secret
