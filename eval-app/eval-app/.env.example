# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจากผู้ดูแล Oracle
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
ORACLE_USER=your_schema_user
ORACLE_PASSWORD=your_schema_password
# ตัวอย่าง: localhost:1521/FREEPDB1 หรือ hostname:1521/service_name
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
# true เฉพาะตอนต้องการสร้างบัญชีทดลองครั้งแรก (PIN ทุกบัญชี 1234)
SEED_DEMO_ACCOUNTS=true
