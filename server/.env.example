# ค่าการเชื่อมต่อ Oracle Database (คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า — ห้ามอัปไฟล์ .env ขึ้น Git)
DB_USER=EVAL_APP
DB_PASSWORD=ChangeThisPassword!
# เครื่อง Windows + Oracle XE:            localhost:1521/XEPDB1
# Codespace (.devcontainer) / Oracle Free: localhost:1521/FREEPDB1   (setup.sh ตั้งให้อัตโนมัติ)
# docker compose: ไม่ต้องใช้ไฟล์นี้ ค่าอยู่ใน docker-compose.yml
DB_CONNECT_STRING=localhost:1521/XEPDB1
PORT=3000
# Set to a long random value before real use. Used to derive session tokens.
SESSION_SECRET=replace-with-a-long-random-secret
